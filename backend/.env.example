# ---------- Servidor ----------
PORT=4000
NODE_ENV=development
# Origen(es) permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# ---------- Base de datos MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nova_salud
# Zona horaria de la sesión MySQL (Lima = -05:00)
DB_TIMEZONE=-05:00

# ---------- Seguridad ----------
# Cambia este valor por una cadena larga y aleatoria
JWT_SECRET=cambia_esta_clave_por_una_cadena_larga_y_aleatoria_de_64_caracteres
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# ---------- Reglas de negocio ----------
# Días de anticipación para alertar productos próximos a vencer
DIAS_ALERTA_VENCIMIENTO=60
# Descuento máximo (% del subtotal) que puede aplicar un vendedor sin ser administrador
DESCUENTO_MAX_VENDEDOR_PCT=10
